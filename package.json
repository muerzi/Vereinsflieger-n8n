{
  "name": "n8n-nodes-vereinsflieger",
  "version": "0.2.0",
  "description": "n8n community node to interact with the Vereinsflieger.de REST API (auth, flights, calendar).",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "vereinsflieger",
    "flightcenterplus"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/muerzi/Vereinsflieger-n8n",
  "author": {
    "name": "Stefan Muerzl",
    "email": "stefan.muerzl@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/muerzi/Vereinsflieger-n8n.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json --ext .ts,.js,.json",
    "lintfix": "eslint nodes credentials package.json --ext .ts,.js,.json --fix",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/VereinsfliegerApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Vereinsflieger/Vereinsflieger.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^4.0.2",
    "jsonc-eslint-parser": "^3.3.0",
    "n8n-workflow": "^1.82.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
